# Stable names for the robot's serial devices, independent of plug order.
# Install: sudo cp deploy/99-robot.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger
# Check:   ls -l /dev/robot-*
#
# SO-101 FOLLOWER arm controller (CH343 USB-serial, serial read 2026-09-27 with
# `udevadm info -a -n /dev/ttyACM0 | grep serial`). The LEADER arm uses the same
# CH343 chip, so matching on idVendor/idProduct alone would give both arms the
# same name - hence the serial match.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5B41532803", SYMLINK+="robot-arm"
# SO-101 LEADER arm (any other CH343). If a second leader ever appears, pin it by serial too.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}!="5B41532803", SYMLINK+="robot-leader"
# Seeed Xiao RP2040 driving the hoverboard (xiao_send_pwm.ino)
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="000a", SYMLINK+="robot-drive"
